# ==============================================================================
# FinancialRecord Backend - Environment Configuration Template
# Salin file ini menjadi .env atau set sebagai sistem environment variables
# ==============================================================================

# Database PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/financialrecord_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Security & JWT (Ganti JWT_SECRET dengan string rahasia minimal 256-bit di production)
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_random_string
JWT_EXPIRATION_MS=86400000

# Cookie Security (Set true jika production menggunakan HTTPS)
COOKIE_SECURE=false

# AI Services Integration
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Storage
UPLOAD_DIR=uploads/receipts

# Rate Limiting
RATE_LIMITING_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_AI_PER_MIN=20
RATE_LIMIT_USER_PER_MIN=120
RATE_LIMIT_ADMIN_PER_MIN=200
RATE_LIMIT_PUBLIC_PER_MIN=300
